# Password for the blog studio at /blogs/admin.
# Leave it unset for local development (the studio will be open and show a warning).
BLOG_ADMIN_PASSWORD=

# Local JSON store. Defaults to data/blogs.json.
# BLOG_DATA_FILE=/var/data/blogs.json

# Vercel Blob store. Connecting a Blob store to the project injects this.
# When present, posts are read from and written to a private JSON blob.
# BLOB_READ_WRITE_TOKEN=
# BLOG_BLOB_PATH=blog/posts.json
